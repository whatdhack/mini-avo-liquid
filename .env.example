# OPENROUTER_API_KEY: required for real Liquid AI mutations (https://openrouter.ai/keys).
# Without it, run_evolution.py falls back to the deterministic analytical simulator.
OPENROUTER_API_KEY="sk-or-v1-..."

# Optional: override the mutation model (default: largest free Liquid model)
# LIQUID_MODEL="liquid/lfm-2.5-2.6b:free"

# Optional: Nimble web search for --web-seed (https://online.nimbleway.com)
# NIMBLE_API_KEY="..."

# Optional: output budget and reasoning effort for the Liquid model
# LIQUID_MAX_TOKENS=8192
# LIQUID_REASONING_EFFORT=high
